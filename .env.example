# The application's connection. Note the role: app_user, never the owner and
# never a superuser — a superuser bypasses row-level security entirely, and the
# owner bypasses it too unless FORCE is set.
DATABASE_URL=postgres://app_user:local_dev_only@localhost:5432/rls_demo

# Migrations connect as the owner. This one never goes into the application's
# environment.
# DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:5432/rls_demo
